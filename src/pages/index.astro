/* Plays on every load of the homepage, for every visitor.
   ?greet=0 suppresses it for one load - use for screenshots, Lighthouse
   runs and SEO audits where a 2.6s overlay would distort the measurement.

   NOTE (2026-08-23): prefers-reduced-motion is deliberately NOT honoured
   here. That was a considered business decision by the owner, not an
   oversight - do not "fix" it in a later session without asking. The
   mitigation that remains is that any click, key, scroll or touch kills
   the overlay instantly, so a motion-sensitive visitor is never held in
   it for longer than it takes to move a finger. */
(function(){
  try{ if (location.search.indexOf('greet=0') > -1) return; }catch(e){}
