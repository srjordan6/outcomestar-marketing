<script is:inline>
/* ===== FIRST-VISIT GREETING: sparks + dismissal ===== */
(function(){
  var g = document.getElementById('greet');
  if (!g || g.className.indexOf('on') === -1) return;

  /* Eight sparks thrown along the mark's own axes and diagonals. */
  var R = window.innerWidth < 600 ? 86 : 118;
  for (var i = 0; i < 8; i++) {
    var a = (Math.PI / 4) * i;
    var s = document.createElement('div');
    s.className = 'gr-spark';
    g.appendChild(s);
    s.animate([
      { opacity: 0, transform: 'translate(0,0) scale(.4)' },
      { opacity: 1, offset: .25 },
      { opacity: 0, transform: 'translate(' + (Math.cos(a)*R).toFixed(1) + 'px,' + (Math.sin(a)*R).toFixed(1) + 'px) scale(.2)' }
    ], { duration: 900, delay: 620 + i * 22, easing: 'cubic-bezier(.15,.7,.3,1)' });
  }

  var done = false;
  function finish(){
    if (done) return;
    done = true;
    g.classList.add('out');
    document.documentElement.style.overflow = '';
    setTimeout(function(){ g.remove(); }, 760);
  }

  /* Retires on its own, or the moment the visitor does anything. */
  var timer = setTimeout(finish, 2600);
  function skip(){ clearTimeout(timer); finish(); }
  g.addEventListener('click', skip);
  addEventListener('keydown', skip, { once:true });
  addEventListener('wheel', skip, { once:true, passive:true });
  addEventListener('touchstart', skip, { once:true, passive:true });
})();
</script>

