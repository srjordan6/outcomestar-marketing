/* ===== FIRST-VISIT GREETING =====================================
   The brand mark introduces itself once, then retires into the
   topbar logo. Fires only on a first visit (localStorage), skips on
   any input, and is fully disabled under prefers-reduced-motion.
   Hidden by default so returning visitors never see a flash; an
   inline script decides before first paint whether to show it. */
#greet{display:none}
#greet.on{
  display:block;position:fixed;inset:0;z-index:9999;background:var(--navy);
  cursor:pointer;
}
#greet.on::after{
  content:"";position:absolute;left:50%;bottom:38px;transform:translateX(-50%);
  width:34px;height:1.5px;background:rgba(255,255,255,.28);
  animation:gr-hint .9s .9s ease-out forwards;opacity:0;
}
@keyframes gr-hint{to{opacity:1}}
#greet.out{
  animation:gr-lift .72s cubic-bezier(.7,0,.3,1) forwards;pointer-events:none;
}
@keyframes gr-lift{to{opacity:0;transform:translateY(-14px)}}
.gr-stage{
  position:absolute;left:50%;top:50%;width:150px;height:150px;
  margin:-75px 0 0 -75px;
}
.gr-mark{
  width:100%;height:100%;transform-origin:50% 50%;
  animation:gr-arrive 1.05s cubic-bezier(.2,1.25,.4,1) .12s both;
}
@keyframes gr-arrive{
  0%{opacity:0;transform:scale(.12) rotate(-115deg)}
  55%{opacity:1}
  100%{opacity:1;transform:scale(1) rotate(0)}
}
.gr-dot{transform-origin:50% 50%;animation:gr-dot .5s cubic-bezier(.2,1.4,.4,1) both}
@keyframes gr-dot{0%{opacity:0;transform:scale(0)}100%{opacity:1;transform:scale(1)}}
.gr-ring{
  position:absolute;left:50%;top:50%;width:150px;height:150px;margin:-75px 0 0 -75px;
  border:1.5px solid var(--orange);border-radius:50%;opacity:0;
  animation:gr-ring .95s cubic-bezier(.15,.7,.3,1) .62s both;
}
@keyframes gr-ring{
  0%{opacity:.55;transform:scale(.3)}
  100%{opacity:0;transform:scale(2.4)}
}
.gr-spark{
  position:absolute;left:50%;top:50%;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;
  border-radius:50%;background:var(--orange);opacity:0;
}
.gr-word{
  position:absolute;left:0;right:0;top:calc(50% + 96px);text-align:center;
  font-family:Lora,Georgia,serif;font-size:19px;color:#fff;letter-spacing:.01em;
  opacity:0;animation:gr-word .7s cubic-bezier(.22,1,.36,1) .74s both;
}
.gr-word b{color:var(--orange);font-weight:600}
@keyframes gr-word{0%{opacity:0;transform:translateY(10px)}100%{opacity:1;transform:none}}
@media(max-width:600px){
  .gr-stage,.gr-ring{width:112px;height:112px;margin:-56px 0 0 -56px}
  .gr-word{top:calc(50% + 78px);font-size:16px;padding:0 24px}
}
/* prefers-reduced-motion is intentionally not applied to the greeting -
   see the note on the inline script above. The instant-skip handlers are
   the escape hatch instead. */
</style>
